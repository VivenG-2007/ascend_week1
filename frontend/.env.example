# CampusVoice Frontend — Environment Variable Reference
# Copy to frontend/.env.local for local development.
# For Vercel: add these as Environment Variables in the Vercel project dashboard.
# ⚠  Never commit frontend/.env.local to git.

# ──────────────────────────────────────────────────────────────────────────────
# Backend API URL
# ──────────────────────────────────────────────────────────────────────────────
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (set in Vercel dashboard):
# NEXT_PUBLIC_API_URL=https://campusvoice-backend.onrender.com
