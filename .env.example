# ⚠  This root-level file is kept for navigation only.
#
# The actual environment templates are in the sub-folders:
#   backend/.env.example   — all backend variables (Azure, Supabase, ChromaDB, Auth, etc.)
#   frontend/.env.example  — frontend variables (NEXT_PUBLIC_API_URL)
#
# Setup:
#   cp backend/.env.example  backend/.env   && edit backend/.env
#   cp frontend/.env.example frontend/.env.local
