# CampusVoice Environment Variables

# College Name
COLLEGE_NAME="Geethanjali College of Engineering and Technology"
FRONTEND_ORIGIN="http://localhost:3000"

# Relational Database:
# For Supabase Cloud: postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# For Local Development: sqlite:///./campusvoice.db
DATABASE_URL="sqlite:///./campusvoice.db"

# Supabase Cloud (Storage & Auth/Data verification)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="campusvoice-documents"

# Vector Database: ChromaDB Cloud or Local
# For Chroma Cloud:
# CHROMA_SERVER_HOST="api.trychroma.com"
# CHROMA_SERVER_HTTP_PORT=443
# CHROMA_CLOUD_API_KEY="your-chroma-cloud-api-key"
# CHROMA_CLOUD_TENANT="default"
# CHROMA_CLOUD_DATABASE="campusvoice"
CHROMA_PERSIST_DIRECTORY="./chroma_db"
CHROMA_COLLECTION_NAME="campusvoice_chunks"

# AI Models (Azure AI Foundry / OpenAI Endpoint)
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_API_VERSION="2024-02-15-preview"

# Deployments & Roles
MODEL_MAIN="gpt-4.1"
MODEL_MINI="gpt-4.1-mini"
MODEL_VISION="gpt-4.1"

# Multilingual Text Embeddings
EMBEDDING_MODEL_NAME="intfloat/multilingual-e5-small"

# Azure AI Document Intelligence (OCR)
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

# Azure AI Speech (STT & TTS Neural Voices)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION="eastus"
AZURE_SPEECH_STT_LANGUAGE="en-IN"
AZURE_SPEECH_TTS_VOICE_EN="en-IN-NeerjaNeural"
AZURE_SPEECH_TTS_VOICE_TE="te-IN-ShrutiNeural"

# Security & Admin Authentication
JWT_SECRET="dev-secret-key-change-in-production-campusvoice"
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME="admin"

# RAG & Guardrails Thresholds
SIMILARITY_THRESHOLD=0.35
MAX_AUDIO_SECONDS=30
MAX_UPLOAD_MB=15
CHUNK_SIZE=500
CHUNK_OVERLAP=50
