# CampusVoice Backend — Environment Variable Reference
# Copy to backend/.env and fill in your values.
# ⚠  Never commit backend/.env to git.
#
# Services used:
#   Azure AI Foundry        — LLM (GPT-4o) + text embeddings (text-embedding-3-large)
#   Azure AI Speech         — STT (speech-to-text) + TTS (text-to-speech)
#   Azure Document Intelligence — OCR for scanned PDFs and images
#   Supabase                — PostgreSQL database + object storage for uploaded documents
#   Chroma Cloud            — vector store (api.trychroma.com)

# ──────────────────────────────────────────────────────────────────────────────
# Core
# ──────────────────────────────────────────────────────────────────────────────
APP_ENV=development                      # development | test | production
COLLEGE_NAME=Demo College of Engineering
FRONTEND_ORIGIN=http://localhost:3000    # comma-separated exact origins, no trailing slash
                                         # production: https://your-app.vercel.app
DATABASE_URL=sqlite:///./campusvoice.db  # dev default
                                         # production: postgresql://USER:PASS@HOST:5432/postgres (Supabase)
LOG_LEVEL=DEBUG                          # DEBUG | INFO | WARNING | ERROR | CRITICAL
                                         # use DEBUG to see every service call in the terminal
MAX_QUESTION_CHARS=1000

# ──────────────────────────────────────────────────────────────────────────────
# Chroma Cloud — vector store (api.trychroma.com)
# Get credentials: https://cloud.trychroma.com → database → "Connect"
# ──────────────────────────────────────────────────────────────────────────────
CHROMA_API_KEY=                          # ck-...
CHROMA_TENANT=                           # UUID from Chroma Cloud dashboard
CHROMA_DATABASE=campusvoice              # database name you created in Chroma Cloud
CHROMA_COLLECTION_NAME=campusvoice_chunks
SIMILARITY_THRESHOLD=0.55               # cosine similarity cutoff (0-1); tune with: python -m app.scripts.tune_threshold
AUTO_REINDEX=true                       # rebuild vector index from DB at startup if vectors are missing

# ──────────────────────────────────────────────────────────────────────────────
# Azure AI Foundry — LLM (GPT-4o)
# One Azure OpenAI resource powers BOTH the chat model and the embedding model.
# ──────────────────────────────────────────────────────────────────────────────
AZURE_AI_FOUNDRY_ENDPOINT=              # https://<resource>.openai.azure.com/
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-4o     # your chat model deployment name
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21
AGENT_MODE=auto                         # auto | azure | offline

# ──────────────────────────────────────────────────────────────────────────────
# Azure AI Foundry — Text Embeddings (same resource, different deployment)
# ──────────────────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=azure                # azure (production) | hash (offline dev/tests ONLY)
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_EMBEDDING_DIMENSION=1536          # 1536 for text-embedding-3-large

# ──────────────────────────────────────────────────────────────────────────────
# Azure AI Speech — STT + TTS
# Separate Azure AI Speech resource (not the same as AI Foundry).
# ──────────────────────────────────────────────────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia       # Azure region of your Speech resource
AZURE_SPEECH_STT_LANGUAGES=en-IN,te-IN # comma-separated locales for auto-detect
AZURE_SPEECH_TTS_VOICE_EN=en-IN-NeerjaNeural
AZURE_SPEECH_TTS_VOICE_TE=te-IN-ShrutiNeural
MAX_AUDIO_SECONDS=30

# ──────────────────────────────────────────────────────────────────────────────
# Azure Document Intelligence — OCR for scanned PDFs and images
# ──────────────────────────────────────────────────────────────────────────────
OCR_PROVIDER=azure                      # azure | none
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=  # https://<resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Supabase — PostgreSQL + Object Storage
# ──────────────────────────────────────────────────────────────────────────────
# Production DATABASE_URL should point to the Supabase PostgreSQL connection string.
SUPABASE_URL=                           # https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=              # backend only — NEVER expose to the frontend
SUPABASE_STORAGE_BUCKET=campusvoice-documents
LOCAL_STORAGE_DIRECTORY=./uploads       # fallback when SUPABASE_URL is empty (dev only)
MAX_UPLOAD_MB=15

# ──────────────────────────────────────────────────────────────────────────────
# Admin authentication
# ──────────────────────────────────────────────────────────────────────────────
# Generate JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
# Generate ADMIN_PASSWORD_HASH: python -m app.scripts.hash_password  (keep single quotes)
ADMIN_PASSWORD_HASH=

# ──────────────────────────────────────────────────────────────────────────────
# Rate limiting (in-process, per Uvicorn worker)
# ──────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=5
